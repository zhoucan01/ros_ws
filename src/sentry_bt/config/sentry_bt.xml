<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <KeepRunningUntilFailure>
      <Sequence>
      <!-- 目标点决策 -->
        <Fallback>
          <Sequence>
            <ScriptCondition code="if_match_started == false"/>
            <SetTargetPoint point="0" target="{target_point}"/>
          </Sequence>

          <Sequence>
            <ScriptCondition code="if_hp_less_100 == true || if_get_allow_17 == true || if_force_stay_home == true"/>
            <SetTargetPoint point="1" target="{target_point}"/>
          </Sequence>

          <Sequence>
            <ScriptCondition code="if_get_manual_msg == true"/>
            <ScriptCondition code="if_manual_target_valid == true"/>
            <SetManualTarget
                manual_target_pose="{manual_target_pose}"
                manual_target_output="{manual_target_result}"/>
          </Sequence>
          
          <Sequence>
            <ScriptCondition code="if_force_enemy_outpost == true"/>
            <SetTargetPoint point="2" target="{target_point}"/>
          </Sequence>

          <!-- <Sequence>
            <ScriptCondition code="if_energy_below_15 == true"/>
            <SetTargetPoint point="7" target="{target_point}"/>
          </Sequence> -->

          

          <!-- <Sequence>
            <ScriptCondition code="if_radar_outpost_target == true"/>
            <SetTargetPoint point="2" target="{target_point}"/>
          </Sequence> -->

          <!-- <ReactiveSequence>
            <ScriptCondition code="if_can_rebuild_outpost == true"/>
            <ScriptCondition code="we_outpost_hp &lt;= 0"/>
            <SetTargetPoint point="3" target="{target_point}"/>
          </ReactiveSequence> -->

          <!-- <Sequence>
            <ScriptCondition code="if_base_low_hp == true"/>
            <SetTargetPoint point="7" target="{target_point}"/>
          </Sequence> -->



          <SetTargetPoint point="7" target="{target_point}"/>
        </Fallback>

        <ForceSuccess>
          <Sequence>
            <ReactiveFallback>
              <Sequence>
                <ScriptCondition code="if_need_to_attack == 1"/>
                <ScriptCondition code="if_need_hp_recover == true"/>
                <AntiAutoAim
                    target_point_port="{target_point}"
                    costmap_port="{nav_globalCostmap}"
                    currentpos_port="{current_pos}"
                    attack_point_port="{attack_target_pose}"
                    attack_target_valid="{attack_target_valid}"
                    enemy_pos_point_port="{enemy_pos_point}"/>
              </Sequence>
              <Script code="attack_target_valid := false"/>
            </ReactiveFallback>

            <SelectFinalTarget
                normal_target_point="{target_point}"
                manual_target_pose="{manual_target_result}"
                attack_target_pose="{attack_target_pose}"
                attack_target_valid="{attack_target_valid}"
                final_target_point="{final_target_point}"
                final_target_pose="{final_target_pose}"
                final_target_source="{final_target_source}"/>

            <PublishNavGoal
                final_target_point="{final_target_point}"
                final_target_source="{final_target_source}"
                final_target_pose="{final_target_pose}"/>
          </Sequence>
        </ForceSuccess>

        <Sequence>
          <ForwardDesiredAttitude desired_attitude="{desired_sentry_attitude}"
                                  attitude_output="{attitude_to_send}"/>
          <SentryAttitudeSwitch sentry_attitude="{attitude_to_send}"/>
        </Sequence>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="SetTargetPoint">
      <input_port name="point" type="int">Target point number</input_port>
      <output_port name="target" type="int">Output target point number</output_port>
    </Action>
    <Action ID="SetManualTarget">
      <input_port name="manual_target_pose" type="geometry_msgs::msg::PoseStamped">Manual target pose</input_port>
      <output_port name="manual_target_output" type="geometry_msgs::msg::PoseStamped">Manual target output</output_port>
    </Action>
    <Action ID="ForwardDesiredAttitude">
      <input_port name="desired_attitude" type="int">Desired attitude from blackboard</input_port>
      <output_port name="attitude_output" type="int">Forwarded desired attitude</output_port>
    </Action>
    <Action ID="SelectFinalTarget">
      <input_port name="normal_target_point" type="int">Normal target point</input_port>
      <input_port name="manual_target_pose" type="geometry_msgs::msg::PoseStamped">Manual target pose</input_port>
      <input_port name="attack_target_pose" type="geometry_msgs::msg::PoseStamped">Attack target pose</input_port>
      <input_port name="attack_target_valid" type="bool">Attack target valid</input_port>
      <output_port name="final_target_point" type="int">Final target point</output_port>
      <output_port name="final_target_pose" type="geometry_msgs::msg::PoseStamped">Final target pose</output_port>
      <output_port name="final_target_source" type="int">1 normal, 2 manual, 3 attack</output_port>
    </Action>
    <Action ID="PublishNavGoal">
      <input_port name="final_target_point" type="int">Final target point number</input_port>
      <input_port name="final_target_source" type="int">Final target source</input_port>
      <input_port name="final_target_pose" type="geometry_msgs::msg::PoseStamped">Final target pose</input_port>
    </Action>
    <Action ID="AntiAutoAim">
      <input_port name="target_point_port" type="int">Initial target point number</input_port>
      <input_port name="costmap_port" type="nav_msgs::msg::OccupancyGrid">Global costmap</input_port>
      <input_port name="currentpos_port" type="geometry_msgs::msg::PointStamped">Current robot position</input_port>
      <input_port name="enemy_pos_point_port" type="geometry_msgs::msg::PointStamped">Enemy offset point</input_port>
      <output_port name="attack_point_port" type="geometry_msgs::msg::PoseStamped">Final attack pose</output_port>
      <output_port name="attack_target_valid" type="bool">Attack target valid</output_port>
    </Action>
    <Action ID="SentryAttitudeSwitch">
      <input_port name="sentry_attitude" type="int">Sentry attitude value</input_port>
    </Action>
  </TreeNodesModel>
</root>
